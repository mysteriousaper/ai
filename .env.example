# Copy to .env (git-ignored). Never commit real values.

# Engine E (appraisal) calls the Claude API from Phase 3 on.
# In the cloud session this key is injected by the network proxy instead.
ANTHROPIC_API_KEY=

# Phase 5 only: your own Supabase project for the personal study.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telemetry stays off (engine/privacy.py sets these by default).
HF_HUB_DISABLE_TELEMETRY=1
MLFLOW_DISABLE_TELEMETRY=true
DO_NOT_TRACK=1
GRADIO_ANALYTICS_ENABLED=False
