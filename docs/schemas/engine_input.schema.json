{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "KeyCategory": {
      "description": "What kind of key was pressed. Holds categories only, never characters (brief §4.2).",
      "enum": [
        "letter",
        "digit",
        "space",
        "backspace",
        "delete",
        "punctuation",
        "enter",
        "modifier",
        "other"
      ],
      "title": "KeyCategory",
      "type": "string"
    },
    "KeystrokeEvent": {
      "additionalProperties": false,
      "description": "One key press. Timestamps are milliseconds on a monotonic clock (e.g. ``performance.now()``).",
      "properties": {
        "key_category": {
          "$ref": "#/$defs/KeyCategory"
        },
        "down_ts": {
          "minimum": 0.0,
          "title": "Down Ts",
          "type": "number"
        },
        "up_ts": {
          "minimum": 0.0,
          "title": "Up Ts",
          "type": "number"
        }
      },
      "required": [
        "key_category",
        "down_ts",
        "up_ts"
      ],
      "title": "KeystrokeEvent",
      "type": "object"
    },
    "MessageContext": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "user_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        },
        "message_index": {
          "minimum": 0,
          "title": "Message Index",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        }
      },
      "required": [
        "session_id",
        "message_index",
        "timestamp"
      ],
      "title": "MessageContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "text": {
      "title": "Text",
      "type": "string"
    },
    "keystroke_events": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/KeystrokeEvent"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Keystroke Events"
    },
    "context": {
      "$ref": "#/$defs/MessageContext"
    }
  },
  "required": [
    "text",
    "context"
  ],
  "title": "EngineInput",
  "type": "object"
}
